# PostgreSQL connection string (required for database-backed features)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a strong random value before enabling authentication
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional OAuth providers (configure only when enabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Storage and email integrations will be configured in a later phase
